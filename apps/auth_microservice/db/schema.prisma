generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              Int            @id @default(autoincrement())
  username        String         @unique
  email           String         @unique
  password        String
  refreshTokens   RefreshToken[]
}

model RefreshToken {
  token           String         @id
  userId          Int
  expiresAt       DateTime
  user            User           @relation(fields: [userId], references: [id])
}
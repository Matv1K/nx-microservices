# Use Node.js LTS version
FROM node:20-alpine AS base

# Install dependencies only when needed
FROM base AS deps
WORKDIR /app

# Copy package files and packages directory (needed for workspaces)
COPY package.json package-lock.json ./
COPY packages ./packages
RUN npm ci

# Generate Prisma Client for posts service
FROM deps AS prisma
COPY apps/posts_microservice/src/prisma/schema.prisma ./apps/posts_microservice/src/prisma/
COPY apps/posts_microservice/prisma.config.ts ./apps/posts_microservice/
COPY tsconfig.json tsconfig.base.json ./
RUN npx prisma generate --schema=./apps/posts_microservice/src/prisma/schema.prisma
# Verify generated client was created
RUN ls -la apps/posts_microservice/src/generated/client/ || (echo "ERROR: Generated client not found" && exit 1)

# Build the application
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=prisma /app/apps/posts_microservice/src/generated ./apps/posts_microservice/src/generated
COPY . .

# Production image
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=development

# Create a non-root user
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nodejs

# Copy necessary files
COPY --from=deps --chown=nodejs:nodejs /app/node_modules ./node_modules
COPY --chown=nodejs:nodejs package.json ./
COPY --chown=nodejs:nodejs tsconfig.json tsconfig.base.json ./
COPY --chown=nodejs:nodejs packages ./packages
COPY --chown=nodejs:nodejs apps ./apps
# Copy generated Prisma Client from custom location
COPY --from=prisma --chown=nodejs:nodejs /app/apps/posts_microservice/src/generated ./apps/posts_microservice/src/generated

# Copy and set up startup script
COPY --chown=nodejs:nodejs start-posts.sh /app/start-posts.sh
RUN sed -i 's/\r$//' /app/start-posts.sh && \
    chmod +x /app/start-posts.sh

USER nodejs

EXPOSE 3002

CMD ["/bin/sh", "/app/start-posts.sh"]

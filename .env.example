# Database Configuration
DB_USER=postgres
DB_HOST=localhost
DB_DATABASE=Innogram
DB_PORT=5432
DB_PASSWORD=your_secure_password_here
DB_URL="postgresql://postgres:your_secure_password_here@localhost:5432/Innogram?schema=public"
DATABASE_URL="postgresql://postgres:your_secure_password_here@localhost:5432/Innogram?schema=public"

# JWT Configuration
JWT_KEY="your_jwt_secret_key_here_make_it_long_and_random"
ACCESS_TOKEN_EXPIRY=180
REFRESH_TOKEN_EXPIRY=600

# Redis Configuration (optional, for Docker use redis service name)
REDIS_HOST=localhost
REDIS_PORT=6379

# Server Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=*

# Logging Configuration
LOG_LEVEL=info

# Google OAuth Configuration (TODO: Required for Google auth implementation)
